# =============================================
# Teranga Civil — Backend Configuration
# Copy this file to .env and fill in your values
# =============================================

# Server port
PORT=5000

# PostgreSQL Database (match docker-compose.yml values)
DATABASE_URL=postgresql://postgres:securepassword@localhost:5440/teranga_civil

# Redis (optional — used for caching)
REDIS_URL=redis://localhost:6381

# JWT Configuration
# ⚠️ IMPORTANT: Change this to a long, random, secret string in production!
JWT_SECRET=change_me_to_a_long_random_secret_key_at_least_32_chars
JWT_EXPIRES_IN=24h

# Environment
NODE_ENV=development
